# Available from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Needed for Stripe webhooks to update user_billing.
SUPABASE_SERVICE_ROLE_KEY=

# Generate with: openssl rand -base64 32
# Keep server-side only. Used to encrypt user-owned AI keys at rest.
AI_KEY_ENCRYPTION_SECRET=

# Server-side key for Grove's in-app research search.
TAVILY_API_KEY=

# Public site URL used for Stripe redirect URLs in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe. Create a Grove Plus product, then add the price IDs.
# npm run stripe:setup can create the product and print the IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PLUS_YEARLY_PRICE_ID=

# After a live test payment, turn off preview in Supabase:
# update public.billing_settings set preview_mode = false where id = true;
